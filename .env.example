CONTAINER_NAME=disc-ingest
CONTAINER_HOSTNAME=disc-ingest

# This directory becomes /mnt/data inside Disc Ingest. Jellyfin should see the
# same host directory through its own bind mount.
CONFIG_DIR=./data/config
MEDIA_DIR=/srv/media

# Run ./scripts/detect-drive.sh on the Linux Docker host to find these.
OPTICAL_BLOCK_DEVICE=/dev/sr0
OPTICAL_GENERIC_DEVICE=/dev/sg0

# The user/group that should own completed files. Run: id -u && id -g
USER_ID=1000
GROUP_ID=1000

# The detection script prints the group IDs that own the optical device nodes.
SUP_GROUP_IDS=24,6
UMASK=0022
TZ=Etc/UTC

# The upstream image can retrieve the public MakeMKV beta key. Replace BETA
# with a purchased key if you have one.
MAKEMKV_KEY=BETA

# Bind only to this host by default. Use 0.0.0.0 for trusted-LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Optional HTTP Basic authentication. If WEB_USERNAME is empty, authentication
# is disabled. Use a reverse proxy for HTTPS before crossing an untrusted link.
WEB_USERNAME=
WEB_PASSWORD=

# Eject the disc after a successful rip.
AUTO_EJECT=1

